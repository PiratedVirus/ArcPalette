{
  "manifest_version": 3,
  "name": "Arc Palette",
  "short_name": "Arc Palette",
  "version": "1.0.0",
  "description": "An Arc-style command palette for Safari: search open tabs, history and the web from one box.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Arc Palette (⌥T)",
    "default_icon": {
      "16": "icons/toolbar-16.png",
      "32": "icons/toolbar-32.png"
    }
  },
  "commands": {
    "toggle-palette": {
      "suggested_key": {
        "default": "Alt+T",
        "mac": "Alt+T"
      },
      "description": "Open the command palette"
    },
    "copy-url": {
      "suggested_key": {
        "default": "Ctrl+Shift+C",
        "mac": "Command+Shift+C"
      },
      "description": "Copy the current page's link"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "palette.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://suggestqueries.google.com/*",
    "https://duckduckgo.com/*"
  ]
}
